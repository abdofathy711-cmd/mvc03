@using MyMVC.Models.Entity
@model Departments

@{
    ViewData["Title"] = "Add Department";
}

@* تعديل: استخدام الكلاس الموحد department-container مع الـ CSS العام *@
<div class="department-container">

    <h1 class="page-title text-center">Add Department</h1>

    @* تعديل: توجيه الفورم بالـ Tag Helpers *@
    <form asp-action="saveadd" asp-controller="Department" method="get">

        <div class="form-group">
            <label asp-for="Name">Department Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter department name" />
        </div>

        <div class="form-group">
            <label asp-for="MgrName">Manager Name</label>
            <input asp-for="MgrName" class="form-control" placeholder="Enter manager name" />
        </div>

        <div class="mt-4">
            @* تعديل: توحيد تصميم زرار الحفظ مع باقي الفورمز *@
            <input type="submit" value="Add Department" class="btn-save" />
            @* تعديل: توحيد رابط الرجوع بنفس التنسيق الموحد *@
            <a asp-action="showall" asp-controller="Department" class="back-link">Back to list</a>
        </div>

    </form>

</div>

