@using MyMVC.Models.viewmodel
@model Departmentviewmodel

@{
    ViewData["Title"] = "Department Details";
}

@* تعديل: وضع التفاصيل في كارت details-container متناسق مع تصميم النظام *@
<div class="details-container">

    <h1 class="page-title text-center">Department Details</h1>

    <div class="details-list">
        <div class="details-item">
            <span class="details-label">Department ID:</span>
            <span class="details-value">#@Model.depID</span>
        </div>

        <div class="details-item">
            <span class="details-label">Department Name:</span>
            <span class="details-value">@Model.DepName</span>
        </div>

        <div class="details-item">
            <span class="details-label">Manager Name:</span>
            <span class="details-value">@Model.ManName</span>
        </div>

        <div class="details-item">
            <span class="details-label">Department State:</span>
            <span>
                @* تعديل: استخدام Badges موحدة تتبع ألوان النظام *@
                @if (Model.DepState == "Main")
                {
                    <span class="app-badge badge-main">Main Department</span>
                }
                else
                {
                    <span class="app-badge badge-branch">Branch Department</span>
                }
            </span>
        </div>
    </div>

    @* تعديل: قسم عرض الطلاب بتنسيق أنيق *@
    <div class="form-group mt-4">
        <label>Students older than 25 in this department:</label>
        @if (Model.students == null || Model.students.Count == 0)
        {
            <div class="alert alert-light border text-muted">
                No students older than 25 found in this department.
            </div>
        }
        else
        {
            <select name="studentId" class="form-control" asp-items="Model.students">
                <option value="">-- View students --</option>
            </select>
        }
    </div>

    <div class="mt-4 pt-2">
        @* تعديل: رابط الرجوع بتنسيق متناسق *@
        <a asp-action="showall" asp-controller="Department" class="btn-action">← Back to Departments</a>
    </div>

</div>
<a href="/Department/showall">Back to list</a>