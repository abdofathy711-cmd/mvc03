@using MyMVC.Models.Entity
@model List<Departments>

@{
    ViewData["Title"] = "All Departments";
}

@* تعديل: استخدام الكلاس الموحد page-title *@
<h1 class="page-title">All Departments</h1>

@* تعديل: استخدام الكلاس الموحد btn-add مع Tag Helper *@
<a asp-action="add" asp-controller="Department" class="btn-add mb-3">New Department</a>

@* تعديل: تغليف الجدول داخل table-card لضبط الحواف والظلال بشكل متناسق *@
<div class="table-card">
    <table class="department-table">
        <thead>
            <tr>
                <th>No</th>
                <th>Name</th>
                <th>Manager</th>
                <th>Actions</th> @* تعديل: إضافة عمود للعمليات لعرض تفاصيل القسم *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@(item.MgrName ?? "-")</td>
                    <td>
                        @* تعديل: زرار Details للانتقال لصفحة تفاصيل القسم بتنسيق btn-action الموحد *@
                        <a asp-action="showbyid" asp-controller="Department" asp-route-id="@item.Id" class="btn-action">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

