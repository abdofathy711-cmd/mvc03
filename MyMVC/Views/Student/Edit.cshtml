@using MyMVC.Models.viewmodel
@using MyMVC.Models.Entity
@model editstudentViewModel

@{
    ViewData["Title"] = "Edit Student";
}

@* تعديل: استخدام الكلاس الموحد student-container مع الـ CSS العام *@
<div class="student-container">

    <h1 class="page-title text-center">Edit Student</h1>

    @* تعديل: توجيه الفورم إلى أكشن EditSave في الكنترولر مع تحديد الطريقة POST *@
    <form asp-action="EditSave" asp-controller="Student" method="post">

        @* تعديل: عرض ملخص الأخطاء العامة إن وُجدت *@
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* تعديل: الـ Id مخفي لكنه ضروري جداً يتبعت مع الـ Post عشان EditSave يعرف يحدّث أنهي طالب *@
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name">Student Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter student name" />
            @* تعديل: إظهار رسالة خطأ التحقق لاسم الطالب *@
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="age">Age</label>
            <input asp-for="age" type="number" class="form-control" placeholder="Enter student age" />
            @* تعديل: إظهار رسالة خطأ التحقق للسن *@
            <span asp-validation-for="age" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DepartmentId">Department</label>
            @* تعديل: SelectList تعرض أسماء الأقسام وترسل الـ DepartmentId، مع خيار افتراضي وإظهار أخطاء التحقق *@
            <select asp-for="DepartmentId" class="form-control"
                    asp-items="@(new SelectList(Model.department, nameof(Departments.Id), nameof(Departments.Name)))">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>

        <div class="mt-4">
            @* تعديل: توحيد تصميم زرار الحفظ مع باقي الفورمز *@
            <input type="submit" value="Save Changes" class="btn-save" />
            @* تعديل: توحيد رابط الرجوع بنفس كلاس back-link الموحد *@
            <a asp-action="alldetails" asp-controller="Student" class="back-link">Back to list</a>
        </div>

    </form>

</div>

@section Scripts {
    @* تعديل: استدعاء partial التحقق من جانب العميل *@
    <partial name="_ValidationScriptsPartial" />
}

