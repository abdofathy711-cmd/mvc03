@using MyMVC.Models.Entity
@* تعديل: تصحيح الصيغة إلى model@ مع كتابة اسم الـ Entity بشكل صحيح Students بدلاً من خطأ Model Student *@
@model Students

@{
    ViewData["Title"] = "Student Details";
}

@* تعديل: توحيد تصميم صفحة التفاصيل مع باقي النظام باستخدام details-container واللون الأخضر *@
<div class="details-container">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title mb-0 border-0 pb-0">Student Details</h1>
        @if (Model != null)
        {
            <span class="app-badge badge-main">ID: #@Model.Id</span>
        }
    </div>
    <hr class="mt-2 mb-4" style="border-color: var(--primary);" />

    @if (Model == null)
    {
        <div class="alert alert-warning text-center">
            No student found with this ID.
        </div>
    }
    else
    {
        <div class="details-list">
            <div class="details-item">
                <span class="details-label">Student ID:</span>
                <span class="details-value">#@Model.Id</span>
            </div>

            <div class="details-item">
                <span class="details-label">Student Name:</span>
                <span class="details-value">@Model.Name</span>
            </div>

            <div class="details-item">
                <span class="details-label">Age:</span>
                <span class="details-value">@(Model.age?.ToString() ?? "Not specified")</span>
            </div>

            <div class="details-item">
                <span class="details-label">Department:</span>
                <span class="details-value">
                    @(Model.department?.Name ?? (Model.DepartmentId.HasValue ? $"Department #{Model.DepartmentId}" : "No department assigned"))
                </span>
            </div>
        </div>

        <div class="mt-4 pt-2 d-flex gap-2 align-items-center">
            @* تعديل: إضافة زر تعديل الطالب وزر الرجوع للقائمة بشكل موحد *@
            <a asp-action="Edit" asp-controller="Student" asp-route-id="@Model.Id" class="btn-action">Edit Student</a>
            <a asp-action="alldetails" asp-controller="Student" class="back-link">← Back to Students list</a>
        </div>
    }

</div>
</div>