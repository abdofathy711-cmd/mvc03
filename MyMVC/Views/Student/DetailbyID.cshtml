@using MyMVC.Models.Entity
@Model Student

<style>
    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, sans-serif;
        background: #f3f5f9;
        color: #1f2937;
    }

    .page {
        max-width: 860px;
        margin: 48px auto;
        padding: 0 16px;
    }

    .header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .header h1 {
            margin: 0;
            font-size: 28px;
        }

    .badge {
        background: #e0e7ff;
        color: #3730a3;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
    }

    .card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .08);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #4f46e5;
        color: #fff;
        text-align: left;
        padding: 14px 18px;
        font-size: 14px;
        letter-spacing: .5px;
    }

    tbody td {
        padding: 14px 18px;
        border-bottom: 1px solid #eef0f4;
    }

    tbody tr:hover {
        background: #eef2ff;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .empty {
        text-align: center;
        padding: 48px 16px;
        color: #6b7280;
    }
</style>

<div class="page">
    <div class="header">
        <h1>Student Details</h1>
        @if (Model != null)
        {
            <span class="badge">ID: @Model.Id</span>
        }
    </div>

    <div class="card">
        @if (Model == null)
        {
            <div class="empty">No student found.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Student Age</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.Id</td>
                        <td>@Model.Name</td>
                        <td>@(Model.age?.ToString() ?? "-")</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>