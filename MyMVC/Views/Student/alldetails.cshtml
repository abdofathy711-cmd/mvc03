@using MyMVC.Models.Entity
@model List<Students>

@{
    ViewData["Title"] = "All Students";
}

@* تعديل: استخدام الكلاس الموحد page-title *@
<h1 class="page-title">All Students</h1>

@* تعديل: زرار إضافة طالب بتنسيق btn-add الموحد *@
<a asp-action="add" asp-controller="Student" class="btn-add mb-3">New Student</a>

@* تعديل: تغليف الجدول داخل table-card لضبط الحواف والظلال بشكل متناسق *@
<div class="table-card">
    <table class="student-table">
        <thead>
            <tr>
                <th>No</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>Actions</th> @* تعديل: إضافة اسم للعمود *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@(item.age?.ToString() ?? "-")</td>
                    @* تعديل: عرض اسم القسم بدلاً من رقمه فقط مع دعم القيمة الفارغة *@
                    <td>@(item.department?.Name ?? (item.DepartmentId.HasValue ? $"Dept #{item.DepartmentId}" : "-"))</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            @* تعديل: زرار Details لعرض تفاصيل الطالب بتنسيق btn-action الموحد *@
                            <a asp-action="DetailbyID" asp-controller="Student" asp-route-id="@item.Id" class="btn-action">Details</a>
                            @* تعديل: تصحيح الرابط للـ Edit باستخدام Tag Helper وتمرير item.Id بتنسيق btn-edit الموحد *@
                            <a asp-action="Edit" asp-controller="Student" asp-route-id="@item.Id" class="btn-edit">Edit</a>
                            @* تعديل: زرار Delete لنقل المستخدم لصفحة تأكيد الحذف المتصلة بالـ Delete View *@
                            <a asp-action="Delete" asp-controller="Student" asp-route-id="@item.Id" class="btn-action btn-danger-action">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>